[Unit]
Description=pgEdge AI DBA Alerter
Documentation=https://github.com/pgEdge/ai-dba-workbench
After=network.target pgedge-ai-dba-server.service
Wants=pgedge-ai-dba-server.service

[Service]
Type=simple
User=pgedge
Group=pgedge
WorkingDirectory=/var/lib/pgedge/ai-dba-alerter

ExecStart=/usr/bin/ai-dba-alerter --config /etc/pgedge/ai-dba-alerter.yaml
StandardOutput=append:/var/log/pgedge/ai-dba-alerter/ai-dba-alerter.log
StandardError=append:/var/log/pgedge/ai-dba-alerter/ai-dba-alerter.log

Environment="PGEDGE_DATA_DIR=/var/lib/pgedge/ai-dba-alerter"
EnvironmentFile=-/etc/pgedge/ai-dba-alerter.env

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pgedge/ai-dba-alerter /var/log/pgedge/ai-dba-alerter
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true

LimitNOFILE=65536
LimitNPROC=4096

SyslogIdentifier=pgedge-ai-dba-alerter

Restart=on-failure
RestartSec=60s
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
