# =============================================================================
# pgEdge AI DBA Workbench — E2E Test Suite Configuration
# =============================================================================
# Copy this file to .env.e2e for local development overrides.
# .env.e2e is gitignored; this .example file is committed for documentation.
#
# Priority order (highest first):
#   1. Environment variables
#   2. config/llm.yaml (or config/e2e-test.yaml for non-LLM settings)
#   3. Hard-coded defaults in the config modules
#
# API keys MUST be set as environment variables — never commit real keys.
# =============================================================================

# ── Core E2E settings ─────────────────────────────────────────────────────────

# Base URL for the web client.
# E2E_BASE_URL=http://localhost:3000

# Base URL for the API server.
# E2E_API_URL=http://localhost:8080

# Admin credentials.
# E2E_ADMIN_USER=admin
# E2E_ADMIN_PASS=E2ETestPass123!

# ── LLM master switch ─────────────────────────────────────────────────────────

# Enable or disable LLM-gated test steps (e.g. Ask Ellie RBAC validation).
# When unset, the test suite auto-detects via GET /api/v1/capabilities.
# Set to "true" or "1" to force LLM tests on; "false" or "0" to force them off.
# E2E_AI_ENABLED=false

# ── Reasoning provider ────────────────────────────────────────────────────────

# LLM provider for reasoning and chat tasks.
# Supported: anthropic | openai | gemini | ollama
# E2E_REASONING_PROVIDER=anthropic

# Model name for reasoning tasks.
# E2E_REASONING_MODEL=claude-sonnet-4-6

# ── Embedding provider ────────────────────────────────────────────────────────

# Provider for embedding tasks. Can differ from the reasoning provider.
# Example: use Anthropic for reasoning and Voyage AI for embeddings.
# Supported: voyage | openai | gemini | cohere | ollama
# E2E_EMBEDDING_PROVIDER=voyage

# Model name for embedding tasks.
# E2E_EMBEDDING_MODEL=voyage-3

# ── API keys (provider-specific) ──────────────────────────────────────────────

# Set only the key for the provider(s) you are using.
# E2E_ANTHROPIC_API_KEY=sk-ant-...
# E2E_OPENAI_API_KEY=sk-...
# E2E_GEMINI_API_KEY=AIza...
# E2E_VOYAGE_API_KEY=pa-...
# E2E_COHERE_API_KEY=...

# Ollama base URL (no API key required).
# E2E_OLLAMA_BASE_URL=http://localhost:11434

# ── Alerter-specific overrides ────────────────────────────────────────────────

# These override the top-level reasoning/embedding config for alerter tests.
# When unset, alerter tests use the same provider/model as server tests.
# E2E_ALERTER_REASONING_PROVIDER=openai
# E2E_ALERTER_REASONING_MODEL=gpt-4o
# E2E_ALERTER_EMBEDDING_PROVIDER=openai
# E2E_ALERTER_EMBEDDING_MODEL=text-embedding-3-small

# ── Install / platform settings ───────────────────────────────────────────────

# INSTALL_MODE=docker
# REPO_CHANNEL=release
# PLATFORM_IMAGE=rocky9
